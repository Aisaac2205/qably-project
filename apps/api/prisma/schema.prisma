generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"

  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  gratuito
  equipo
  empresa
}

enum OrgRole {
  owner
  admin
  member
}

enum CasePriority {
  critical
  high
  medium
  low
}

enum CaseState {
  active
  draft
  deprecated
}

enum ConnectionProvider {
  GITHUB
  BITBUCKET
}

model User {
  id            String      @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   OrgMember[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String      @id @default(cuid())
  name        String
  slug        String
  plan        Plan        @default(gratuito)
  maxProjects Int         @default(3)
  maxUsers    Int         @default(5)
  maxCases    Int         @default(100)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  members     OrgMember[]
  projects    Project[]
  suites      Suite[]
  connections Connection[]

  @@unique([slug])
  @@map("organization")
}

model OrgMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(member)
  joinedAt       DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("org_member")
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  connectionId   String?
  connection     Connection?  @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  technologies   String[]     @default([])
  testFilePatterns String[]   @default(["*.spec.ts", "*.test.ts"])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  suites         Suite[]
  apiKeys        ApiKey[]
  ingestionBatches IngestionBatch[]
  codeChanges    CodeChange[]
  evidence       Evidence[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([connectionId])
  @@map("project")
}

model ApiKey {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  lookupId       String
  hashedSecret   String
  lastFour       String
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@unique([lookupId])
  @@index([projectId])
  @@index([organizationId])
  @@map("api_key")
}

model Suite {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String       @default("")
  tags           String[]     @default([])
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cases          TestCase[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([organizationId])
  @@map("suite")
}

model TestCase {
  id             String       @id @default(cuid())
  suiteId        String
  suite          Suite        @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  name           String
  steps          String[]     @default([])
  expectedResult String       @default("")
  priority       CasePriority @default(medium)
  state          CaseState    @default(active)
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([suiteId])
  @@index([suiteId, position])
  @@map("test_case")
}

model Connection {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       ConnectionProvider
  name           String
  repo           String
  encryptedWebhookSecret String
  events         ScmEvent[]
  projects       Project[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, provider, repo])
  @@index([organizationId])
  @@map("connection")
}

enum ScmEventKind {
  PUSH
  PULL_REQUEST
}

enum ScmEventStatus {
  PENDING
  PROCESSED
  FAILED
}

model ScmEvent {
  id             String             @id @default(cuid())
  connectionId   String
  connection     Connection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  organizationId String
  provider       ConnectionProvider
  eventId        String
  kind           ScmEventKind
  repo           String
  branch         String
  commitSha      String
  author         String
  title          String
  url            String
  changedFiles   String[]           @default([])
  status         ScmEventStatus     @default(PENDING)
  receivedAt     DateTime           @default(now())
  batches        IngestionBatch[]

  @@unique([provider, eventId])
  @@index([organizationId])
  @@index([connectionId])
  @@map("scm_event")
}

enum EvidenceKind {
  SOURCE_EXCERPT
  ARTIFACT
  URL
}

enum IngestionSource {
  REPOSITORY
  WEBHOOK
}

enum IngestionBatchStatus {
  PENDING
  COMPLETED
  FAILED
}

model Evidence {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      EvidenceKind
  title     String
  uri       String
  excerpt   String?
  createdAt DateTime     @default(now())
  codeChanges CodeChange[]

  @@index([projectId])
  @@map("evidence")
}

model IngestionBatch {
  id          String               @id @default(cuid())
  projectId   String
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scmEventId  String?
  scmEvent    ScmEvent?            @relation(fields: [scmEventId], references: [id], onDelete: SetNull)
  source      IngestionSource
  status      IngestionBatchStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  codeChanges CodeChange[]

  @@unique([scmEventId, projectId])
  @@index([projectId])
  @@map("ingestion_batch")
}

model CodeChange {
  id                String         @id @default(cuid())
  projectId         String
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batchId           String
  batch             IngestionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  evidenceId        String
  evidence          Evidence       @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  pullRequestNumber Int?
  commitSha         String
  filePath          String
  diff              String         @default("")
  detectedPattern   String?
  createdAt         DateTime       @default(now())

  @@unique([batchId, filePath])
  @@index([projectId])
  @@index([batchId])
  @@map("code_change")
}
