generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"

  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  gratuito
  equipo
  empresa
}

enum OrgRole {
  owner
  admin
  member
}

enum CasePriority {
  critical
  high
  medium
  low
}

enum CaseState {
  active
  draft
  deprecated
}

enum ConnectionProvider {
  GITHUB
  BITBUCKET
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  email                   String
  emailVerified           Boolean                  @default(false)
  image                   String?
  locale                  String                   @default("en")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  sessions                Session[]
  accounts                Account[]
  memberships             OrgMember[]
  runs                    Run[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  reviewDecisions         ReviewDecision[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                      String                   @id @default(cuid())
  name                    String
  slug                    String
  plan                    Plan                     @default(gratuito)
  maxProjects             Int                      @default(3)
  maxUsers                Int                      @default(5)
  maxCases                Int                      @default(100)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  members                 OrgMember[]
  projects                Project[]
  suites                  Suite[]
  connections             Connection[]
  runs                    Run[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  notificationWebhooks    NotificationWebhook[]

  @@unique([slug])
  @@map("organization")
}

model OrgMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole      @default(member)
  joinedAt       DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("org_member")
}

model Project {
  id                String              @id @default(cuid())
  organizationId    String
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  connectionId      String?
  connection        Connection?         @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  technologies      String[]            @default([])
  testFilePatterns  String[]            @default(["*.spec.ts", "*.test.ts"])
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  suites            Suite[]
  apiKeys           ApiKey[]
  runs              Run[]
  ingestionBatches  IngestionBatch[]
  codeChanges       CodeChange[]
  evidence          Evidence[]
  testCases         TestCase[]
  proposals         ExtractedProposal[]
  traceabilityLinks TraceabilityLink[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([connectionId])
  @@map("project")
}

model ApiKey {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  lookupId       String
  hashedSecret   String
  lastFour       String
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  @@unique([lookupId])
  @@index([projectId])
  @@index([organizationId])
  @@map("api_key")
}

model Suite {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String       @default("")
  tags           String[]     @default([])
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  cases          TestCase[]
  runs           Run[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([organizationId])
  @@map("suite")
}

model TestCase {
  id               String              @id @default(cuid())
  suiteId          String
  suite            Suite               @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  projectId        String
  project          Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  steps            String[]            @default([])
  expectedResult   String              @default("")
  priority         CasePriority        @default(medium)
  state            CaseState           @default(active)
  position         Int                 @default(0)
  currentVersionId String?             @unique
  currentVersion   TestCaseVersion?    @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  runCases         RunCase[]
  versions         TestCaseVersion[]   @relation("TestCaseVersions")
  proposals        ExtractedProposal[]

  @@unique([suiteId, name])
  @@index([suiteId])
  @@index([suiteId, position])
  @@index([projectId])
  @@map("test_case")
}

model Connection {
  id                     String             @id @default(cuid())
  organizationId         String
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider               ConnectionProvider
  name                   String
  repo                   String
  encryptedWebhookSecret String
  events                 ScmEvent[]
  projects               Project[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@unique([organizationId, provider, repo])
  @@index([organizationId])
  @@map("connection")
}

enum ScmEventKind {
  PUSH
  PULL_REQUEST
}

enum ScmEventStatus {
  PENDING
  PROCESSED
  FAILED
}

model ScmEvent {
  id             String             @id @default(cuid())
  connectionId   String
  connection     Connection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  organizationId String
  provider       ConnectionProvider
  eventId        String
  kind           ScmEventKind
  repo           String
  branch         String
  commitSha      String
  author         String
  title          String
  url            String
  changedFiles   String[]           @default([])
  status         ScmEventStatus     @default(PENDING)
  receivedAt     DateTime           @default(now())
  batches        IngestionBatch[]

  @@unique([provider, eventId])
  @@index([organizationId])
  @@index([connectionId])
  @@map("scm_event")
}

enum EvidenceKind {
  SOURCE_EXCERPT
  ARTIFACT
  URL
}

enum IngestionSource {
  REPOSITORY
  WEBHOOK
}

enum IngestionBatchStatus {
  PENDING
  COMPLETED
  FAILED
}

model Evidence {
  id          String              @id @default(cuid())
  projectId   String
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind        EvidenceKind
  title       String
  uri         String
  excerpt     String?
  createdAt   DateTime            @default(now())
  codeChanges CodeChange[]
  proposals   ExtractedProposal[]

  @@index([projectId])
  @@map("evidence")
}

model IngestionBatch {
  id          String               @id @default(cuid())
  projectId   String
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scmEventId  String?
  scmEvent    ScmEvent?            @relation(fields: [scmEventId], references: [id], onDelete: SetNull)
  source      IngestionSource
  status      IngestionBatchStatus @default(PENDING)
  createdAt   DateTime             @default(now())
  codeChanges CodeChange[]

  @@unique([scmEventId, projectId])
  @@index([projectId])
  @@map("ingestion_batch")
}

model CodeChange {
  id                String             @id @default(cuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batchId           String
  batch             IngestionBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  evidenceId        String
  evidence          Evidence           @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  pullRequestNumber Int?
  commitSha         String
  filePath          String
  diff              String             @default("")
  detectedPattern   String?
  createdAt         DateTime           @default(now())
  proposal          ExtractedProposal?

  @@unique([batchId, filePath])
  @@index([projectId])
  @@index([batchId])
  @@map("code_change")
}

enum ProposalStatus {
  in_review
  approved
  rejected
  changes_requested
}

enum ReviewDecisionAction {
  approved
  rejected
  changes_requested
}

enum TraceabilityEntityType {
  code_change
  evidence
  proposal
  test_case
  test_case_version
  run
  run_case
  quality_risk
}

enum TraceabilityRelation {
  evidence_for
  produced
  version_of
  executed_as
  signals
}

model ExtractedProposal {
  id               String           @id @default(cuid())
  projectId        String
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceId       String
  evidence         Evidence         @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  codeChangeId     String?          @unique
  codeChange       CodeChange?      @relation(fields: [codeChangeId], references: [id], onDelete: SetNull)
  targetTestCaseId String?
  targetTestCase   TestCase?        @relation(fields: [targetTestCaseId], references: [id], onDelete: SetNull)
  status           ProposalStatus   @default(in_review)
  title            String
  objective        String           @default("")
  preconditions    String[]         @default([])
  steps            String[]         @default([])
  expectedResult   String           @default("")
  priority         CasePriority     @default(medium)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  decisions        ReviewDecision[]

  @@index([projectId])
  @@index([projectId, status])
  @@index([targetTestCaseId])
  @@map("extracted_proposal")
}

model ReviewDecision {
  id         String               @id @default(cuid())
  proposalId String
  proposal   ExtractedProposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User                 @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     ReviewDecisionAction
  comment    String?
  decidedAt  DateTime             @default(now())

  @@index([proposalId])
  @@index([actorId])
  @@map("review_decision")
}

model TestCaseVersion {
  id             String       @id @default(cuid())
  testCaseId     String
  testCase       TestCase     @relation("TestCaseVersions", fields: [testCaseId], references: [id], onDelete: Cascade)
  currentFor     TestCase?    @relation("CurrentVersion")
  version        Int
  title          String
  objective      String       @default("")
  preconditions  String[]     @default([])
  steps          String[]     @default([])
  expectedResult String       @default("")
  priority       CasePriority @default(medium)
  publishedAt    DateTime     @default(now())

  @@unique([testCaseId, version])
  @@index([testCaseId])
  @@map("test_case_version")
}

model TraceabilityLink {
  id        String                 @id @default(cuid())
  projectId String
  project   Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromType  TraceabilityEntityType
  fromId    String
  toType    TraceabilityEntityType
  toId      String
  relation  TraceabilityRelation
  createdAt DateTime               @default(now())

  @@unique([fromType, fromId, toType, toId, relation])
  @@index([projectId])
  @@index([fromType, fromId])
  @@index([toType, toId])
  @@map("traceability_link")
}

enum RunStatus {
  pending
  running
  pass
  fail
}

enum RunCaseStatus {
  pending
  running
  pass
  fail
  skip
  blocked
}

enum RunSource {
  manual
  api
  github_actions
}

model Run {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  suiteId        String
  suite          Suite        @relation(fields: [suiteId], references: [id], onDelete: Cascade)
  name           String
  status         RunStatus    @default(pending)
  source         RunSource
  externalId     String?
  startedAt      DateTime     @default(now())
  finishedAt     DateTime?
  executedById   String?
  executedBy     User?        @relation(fields: [executedById], references: [id], onDelete: SetNull)
  commitSha      String?
  commitMessage  String?
  commitAuthor   String?
  cases          RunCase[]

  @@unique([projectId, source, externalId])
  @@index([projectId, startedAt])
  @@index([organizationId])
  @@index([organizationId, startedAt])
  @@index([commitSha])
  @@map("run")
}

model RunCase {
  id             String        @id @default(cuid())
  runId          String
  run            Run           @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCaseId     String?
  testCase       TestCase?     @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  name           String
  suiteName      String
  steps          String[]      @default([])
  expectedResult String        @default("")
  status         RunCaseStatus @default(pending)
  position       Int           @default(0)
  recordedAt     DateTime?

  @@unique([runId, position])
  @@index([runId])
  @@index([testCaseId])
  @@map("run_case")
}

enum NotificationEventType {
  run_failed
  run_completed
  case_regressed
  ingestion_failed
  connection_security
}

enum NotificationChannel {
  in_app
  email
  slack
  discord
}

enum NotificationWebhookType {
  slack
  discord
}

enum NotificationSeverity {
  critical
  high
  medium
  low
}

model Notification {
  id               String                @id @default(cuid())
  organizationId   String
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType        NotificationEventType
  severity         NotificationSeverity
  payload          Json
  dedupeKey        String
  projectId        String?
  runId            String?
  testCaseId       String?
  ingestionBatchId String?
  connectionId     String?
  createdAt        DateTime              @default(now())
  readAt           DateTime?

  @@unique([userId, organizationId, dedupeKey])
  @@index([userId, readAt])
  @@index([organizationId, createdAt])
  @@map("notification")
}

model NotificationPreference {
  id             String                @id @default(cuid())
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventType      NotificationEventType
  channel        NotificationChannel
  enabled        Boolean

  @@unique([userId, organizationId, eventType, channel])
  @@map("notification_preference")
}

model NotificationWebhook {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           NotificationWebhookType
  name           String
  encryptedUrl   String
  enabled        Boolean                 @default(true)
  eventTypes     NotificationEventType[]
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([organizationId])
  @@map("notification_webhook")
}
