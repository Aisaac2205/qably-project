NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://qably:qably@localhost:5432/qably
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
BETTER_AUTH_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
ENCRYPTION_KEY=replace-with-64-hex-characters-0000000000000000000000000000000

GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Optional. Without it, repository code extraction is skipped.
ANTHROPIC_API_KEY=

# Optional. Without it, MailerService logs a warning and skips sending any email
# (password reset, email verification, and future notification emails).
RESEND_API_KEY=

# Optional, but required alongside RESEND_API_KEY for outbound mail to have a
# sender address. Format: "Display Name <address@domain>". Without it, emails
# sent while RESEND_API_KEY is set will use an empty sender address.
RESEND_FROM_EMAIL="Qably <alerts@qably.dev>"
