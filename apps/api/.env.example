NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://qably:qably@localhost:5432/qably
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=replace-with-a-random-32-character-secret
BETTER_AUTH_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
ENCRYPTION_KEY=replace-with-64-hex-characters-0000000000000000000000000000000

GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret

# Optional. Gemini key for extraction, suite summaries and chat. Without it,
# repository code extraction is skipped and chat reports the provider as unavailable.
# GEMINI_API_KEY=

# Optional. Gemini model id used for extraction, suite summaries and chat.
# Defaults to gemini-3.1-flash-lite.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. Maximum Gemini calls per Pacific calendar day against the platform
# key, counted in Redis across extraction and chat. Unset means unmetered.
# AERIS_DAILY_BUDGET=500

# Optional. The most test files one push may send to AI extraction, counted per
# project (one push to a connection with N projects can send up to N times this).
# A push above it is skipped whole and the organization is notified. Default 50.
# EXTRACTION_MAX_FILES_PER_BATCH=50

# Optional. Without it, MailerService logs a warning and skips sending any email
# (password reset, email verification, and future notification emails).
RESEND_API_KEY=

# Optional, but required alongside RESEND_API_KEY for outbound mail to have a
# sender address. Format: "Display Name <address@domain>". Without it, emails
# sent while RESEND_API_KEY is set will use an empty sender address.
RESEND_FROM_EMAIL="Qably <alerts@qably.dev>"
