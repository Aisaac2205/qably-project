---
import { ArrowLeft, ArrowRight } from '@phosphor-icons/react';
import type { DocContent } from '../content/types';
import type { PageLink } from '../lib/pages';

interface Props {
  content: DocContent;
  previous: PageLink | null;
  next: PageLink | null;
}

const { content, previous, next } = Astro.props;

// Quiet cards: at rest a hairline and muted text; on hover the border and the
// text brighten together. Only colour moves, and not under prefers-reduced-motion.
const card =
  'group flex flex-col gap-1 rounded-xl border border-border p-4 transition-colors duration-150 ease-out hover:border-border-strong motion-reduce:transition-none';
const direction =
  'flex items-center gap-1.5 text-sm text-fg-subtle transition-colors duration-150 ease-out group-hover:text-fg-muted motion-reduce:transition-none';
const title =
  'text-base font-medium text-fg-muted transition-colors duration-150 ease-out group-hover:text-fg motion-reduce:transition-none';
---

{
  (previous !== null || next !== null) && (
    <nav aria-label={content.pagerAriaLabel} class="mt-16 grid gap-3 border-t border-border pt-8 sm:grid-cols-2">
      {previous !== null && (
        <a href={previous.path} rel="prev" class={card}>
          <span class={direction}>
            <ArrowLeft size={14} aria-hidden="true" />
            {content.previousLabel}
          </span>
          <span class={title}>{previous.navLabel}</span>
        </a>
      )}
      {next !== null && (
        <a href={next.path} rel="next" class:list={[card, 'items-end text-right sm:col-start-2']}>
          <span class={direction}>
            {content.nextLabel}
            <ArrowRight size={14} aria-hidden="true" />
          </span>
          <span class={title}>{next.navLabel}</span>
        </a>
      )}
    </nav>
  )
}
