---
import type { Locale } from '../../i18n/types';
import type { DocContent, DocPage } from '../content/types';
import { docsBasePath, getPrevNext, isSectionHeadingVisible } from '../lib/pages';
import { createRenderContext } from '../lib/render-context';
import DocsBlocks from './DocsBlocks.astro';
import DocsInteractions from './DocsInteractions.astro';
import DocsPager from './DocsPager.astro';

interface Props {
  content: DocContent;
  locale: Locale;
  page: DocPage;
  /** Label of the nav group that holds the page, shown in the breadcrumb. */
  groupLabel?: string;
}

const { content, locale, page, groupLabel } = Astro.props;
const { previous, next } = getPrevNext(content, locale, page.slug);
const ctx = createRenderContext(content, locale);
---

<DocsInteractions />

<article class="text-fg-muted" data-docs-article data-docs-page={page.slug}>
  <header class="space-y-4 border-b border-border pb-8">
    <nav aria-label={content.breadcrumbAriaLabel}>
      <ol class="flex flex-wrap items-center gap-x-2 text-sm text-fg-muted">
        <li>
          <a href={docsBasePath(locale)} class="transition-colors duration-150 ease-out hover:text-fg motion-reduce:transition-none">{content.docsLabel}</a>
        </li>
        {
          groupLabel !== undefined && (
            <>
              <li aria-hidden="true">/</li>
              <li class="text-fg">{groupLabel}</li>
            </>
          )
        }
      </ol>
    </nav>
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-fg text-balance">{page.title}</h1>
    <p class="max-w-prose text-pretty text-lg leading-8 text-fg-muted">{page.description}</p>
  </header>

  {/* Sections sit 3rem apart, so a heading always has more air above it than below. */}
  <div class="mt-12 space-y-12">
    {
      page.sections.map((section) =>
        isSectionHeadingVisible(page, section) ? (
          <section id={section.id} aria-labelledby={`${section.id}-heading`} class="scroll-mt-docs-offset">
            <h2 id={`${section.id}-heading`} class="text-2xl font-semibold tracking-tight text-fg text-balance">
              {section.title}
            </h2>
            <div class="mt-4 space-y-4">
              <DocsBlocks
                blocks={section.blocks}
                sectionId={section.id}
                ctx={ctx}
              />
            </div>
          </section>
        ) : (
          <div id={section.id} class="scroll-mt-docs-offset space-y-4">
            <DocsBlocks
              blocks={section.blocks}
              sectionId={section.id}
              subheadingLevel={2}
              ctx={ctx}
            />
          </div>
        ),
      )
    }
  </div>

  <DocsPager content={content} previous={previous} next={next} />
</article>
