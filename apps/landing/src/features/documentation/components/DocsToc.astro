---
import { List } from '@phosphor-icons/react';
import type { DocContent } from '../content/types';
import type { TocEntry } from '../lib/toc';
import DocsTocList from './DocsTocList.astro';

interface Props {
  content: DocContent;
  entries: TocEntry[];
  /** False when the page has too few headings for a contents list to be useful. */
  show: boolean;
}

const { content, entries, show } = Astro.props;
---

{
  /*
    Right rail: xl and up. The column is reserved even when the page has no
    contents list, so the article keeps the same width from page to page.
    It stretches to the height of the article (self-stretch) because a pinned
    child can only travel inside its parent: in a column as short as the list
    the list would scroll away with the page. Below xl the same entries live in
    DocsMobileNav.
  */
}
<div class="hidden w-docs-toc shrink-0 self-stretch xl:block">
  {
    show && (
      <div class="sticky top-docs-offset max-h-docs-rail overflow-y-auto overscroll-contain p-1">
        <nav aria-labelledby="docs-toc-title" data-docs-toc>
          <p id="docs-toc-title" class="mb-3 flex items-center gap-2 px-3 text-sm font-semibold text-fg">
            <span aria-hidden="true" class="shrink-0 text-fg-muted">
              <List size={16} />
            </span>
            {content.tocLabel}
          </p>
          <DocsTocList entries={entries} />
        </nav>
      </div>
    )
  }
</div>
