---
import type { Locale } from '../../i18n/types';

interface Props {
  locale: Locale;
  authUrl: string;
}

const { locale, authUrl } = Astro.props;
const isEn = locale === 'en';
const homeHref = isEn ? '/en' : '/';
const altDocsHref = isEn ? '/docs' : '/en/docs';
---

<header class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-6 py-3.5 flex items-center justify-between">
    <div class="flex items-center gap-6">
      <a href={homeHref} class="flex items-center gap-2 group" aria-label={isEn ? 'Back to the homepage' : 'Volver a la landing'}>
        <img src="/qably-sidebar.svg" alt="Qably" class="h-6 w-auto brightness-0 invert object-contain" />
      </a>
      <span class="text-sm text-fg-subtle hidden sm:inline">{isEn ? 'Official Docs' : 'Docs Oficiales'}</span>
    </div>

    <div class="flex items-center gap-3">
      <a
        href={altDocsHref}
        class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-border bg-bg-elevated hover:bg-bg-hover text-sm text-fg-muted hover:text-fg"
      >
        <img src="/traducir.png" alt="" aria-hidden="true" class="size-3.5 brightness-0 invert object-contain" />
        <span>{isEn ? 'ES' : 'EN'}</span>
      </a>
      <a href={homeHref} class="text-sm text-fg-muted hover:text-fg transition-colors">
        {isEn ? 'Back' : 'Volver'}
      </a>
      <a href={authUrl}>
        <button class="px-3 py-1.5 rounded-lg bg-primary text-primary-fg font-semibold text-sm hover:bg-primary-hover transition-colors cursor-pointer">
          {isEn ? 'Go to App' : 'Ir a la App'}
        </button>
      </a>
    </div>
  </div>
</header>
