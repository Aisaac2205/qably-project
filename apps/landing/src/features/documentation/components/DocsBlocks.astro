---
import type { DocBlock } from '../content/types';
import CodeBlock from './CodeBlock.astro';
import CodeGroup from './CodeGroup.astro';
import type { DocsRenderContext } from '../lib/render-context';
import { subheadingId } from '../lib/toc';
import DocsBlocks from './DocsBlocks.astro';
import Inline from './Inline.astro';

interface Props {
  blocks: DocBlock[];
  /** Locale, copy labels and link resolution of the page being rendered. */
  ctx: DocsRenderContext;
  /** Section the blocks belong to: subheadings derive their anchor from it. */
  sectionId?: string;
  /** h3 under a visible section heading; h2 when the section heading is not rendered. */
  subheadingLevel?: 2 | 3;
}

const { blocks, ctx, sectionId, subheadingLevel = 3 } = Astro.props;
const Subheading = subheadingLevel === 2 ? 'h2' : 'h3';

const calloutClasses = {
  info: 'border-border bg-bg-elevated text-fg-muted',
  warning: 'border-warn/30 bg-warn/[0.06] text-fg-muted',
};
---

{
  blocks.map((block) => (
    <Fragment>
      {block.type === 'paragraph' && (
        <p class="text-sm sm:text-base text-fg-muted leading-relaxed">
          <Inline text={block.text} ctx={ctx} />
        </p>
      )}

      {block.type === 'subheading' && (
        <Subheading
          id={sectionId === undefined ? undefined : subheadingId(sectionId, block.text)}
          class="scroll-mt-24 text-base sm:text-lg font-semibold text-fg pt-2"
        >
          <Inline text={block.text} ctx={ctx} />
        </Subheading>
      )}

      {block.type === 'list' && !block.ordered && (
        <ul class="list-disc space-y-2 pl-5 text-sm sm:text-base text-fg-muted leading-relaxed">
          {block.items.map((item) => (
            <li>
              <Inline text={item} ctx={ctx} />
            </li>
          ))}
        </ul>
      )}

      {block.type === 'list' && block.ordered && (
        <ol class="list-decimal space-y-2 pl-5 text-sm sm:text-base text-fg-muted leading-relaxed">
          {block.items.map((item) => (
            <li>
              <Inline text={item} ctx={ctx} />
            </li>
          ))}
        </ol>
      )}

      {block.type === 'code' && (
        <CodeBlock
          language={block.language}
          code={block.code}
          label={block.label}
          copyLabel={ctx.copyLabel}
          copiedLabel={ctx.copiedLabel}
        />
      )}

      {block.type === 'codeGroup' && (
        <CodeGroup
          label={block.label}
          variants={block.variants}
          copyLabel={ctx.copyLabel}
          copiedLabel={ctx.copiedLabel}
        />
      )}

      {block.type === 'table' && (
        <div class="overflow-x-auto rounded-xl border border-border">
          <table class="w-full text-left text-sm sm:text-base">
            <thead>
              <tr class="border-b border-border bg-bg-elevated">
                {block.headers.map((header) => (
                  <th class="px-4 py-2.5 font-semibold text-fg">
                    <Inline text={header} ctx={ctx} />
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {block.rows.map((row) => (
                <tr class="border-b border-border last:border-b-0">
                  {row.map((cell) => (
                    <td class="px-4 py-2.5 align-top text-fg-muted">
                      <Inline text={cell} ctx={ctx} />
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {block.type === 'callout' && (
        <div class={`rounded-xl border px-4 py-3 text-sm sm:text-base leading-relaxed ${calloutClasses[block.tone]}`}>
          <Inline text={block.text} ctx={ctx} />
        </div>
      )}

      {block.type === 'logoRow' && (
        <div class="flex flex-wrap gap-3">
          {block.items.map((item) => (
            <div class="flex items-center gap-2 rounded-xl border border-border bg-bg-elevated px-3 py-2">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary p-1">
                <img src={item.src} alt={item.alt} width="16" height="16" class="size-4" />
              </span>
              <span class="text-sm font-medium text-fg">{item.label}</span>
            </div>
          ))}
        </div>
      )}

      {block.type === 'faq' && (
        <dl class="space-y-6">
          {block.items.map((item) => (
            <div>
              <dt class="text-base font-semibold text-fg">
                <Inline text={item.question} ctx={ctx} />
              </dt>
              <dd class="mt-2 space-y-3">
                <DocsBlocks blocks={item.answer} ctx={ctx} />
              </dd>
            </div>
          ))}
        </dl>
      )}
    </Fragment>
  ))
}
