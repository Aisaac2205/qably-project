---
import type { DocBlock } from '../content/types';
import Callout from './Callout.astro';
import CodeBlock from './CodeBlock.astro';
import CodeGroup from './CodeGroup.astro';
import type { DocsRenderContext } from '../lib/render-context';
import { subheadingId } from '../lib/toc';
import DocsBlocks from './DocsBlocks.astro';
import Inline from './Inline.astro';

interface Props {
  blocks: DocBlock[];
  /** Locale, UI labels and link resolution of the page being rendered. */
  ctx: DocsRenderContext;
  /** Section the blocks belong to: subheadings derive their anchor from it. */
  sectionId?: string;
  /** h3 under a visible section heading; h2 when the section heading is not rendered. */
  subheadingLevel?: 2 | 3;
  /**
   * Prefix of the ids of the blocks that need one (the tabs of a code group).
   * Defaults to the section id, so ids come from the content, not from chance.
   */
  idPrefix?: string;
}

const { blocks, ctx, sectionId, subheadingLevel = 3, idPrefix = sectionId ?? 'docs' } = Astro.props;
const Subheading = subheadingLevel === 2 ? 'h2' : 'h3';
---

{
  /*
    Reading rhythm: prose is body text (1rem, 1.75 leading) in the muted colour
    and capped at a comfortable measure; headings, bold words and table headers
    carry the full foreground. Code, tables and diagrams use the whole column.
  */
}
{
  blocks.map((block, index) => (
    <Fragment>
      {block.type === 'paragraph' && (
        <p class="max-w-prose text-pretty text-base leading-7 text-fg-muted">
          <Inline text={block.text} ctx={ctx} />
        </p>
      )}

      {block.type === 'subheading' && (
        <Subheading
          id={sectionId === undefined ? undefined : subheadingId(sectionId, block.text)}
          class="scroll-mt-docs-offset pt-4 text-lg font-semibold tracking-tight text-fg text-balance"
        >
          <Inline text={block.text} ctx={ctx} />
        </Subheading>
      )}

      {block.type === 'list' && !block.ordered && (
        <ul class="max-w-prose list-disc space-y-2 pl-6 text-base leading-7 text-fg-muted marker:text-fg-subtle">
          {block.items.map((item) => (
            <li>
              <Inline text={item} ctx={ctx} />
            </li>
          ))}
        </ul>
      )}

      {block.type === 'list' && block.ordered && (
        <ol class="max-w-prose list-decimal space-y-2 pl-6 text-base leading-7 text-fg-muted marker:text-fg-subtle">
          {block.items.map((item) => (
            <li>
              <Inline text={item} ctx={ctx} />
            </li>
          ))}
        </ol>
      )}

      {block.type === 'code' && (
        <CodeBlock
          language={block.language}
          code={block.code}
          label={block.label}
          copyLabel={ctx.copyLabel}
          copiedLabel={ctx.copiedLabel}
        />
      )}

      {block.type === 'codeGroup' && (
        <CodeGroup
          label={block.label}
          variants={block.variants}
          groupId={`${idPrefix}-code-group-${index}`}
          copyLabel={ctx.copyLabel}
          copiedLabel={ctx.copiedLabel}
        />
      )}

      {block.type === 'table' && (
        <div class="overflow-x-auto rounded-xl border border-border">
          <table class="w-full text-left text-sm leading-6">
            <thead>
              <tr class="border-b border-border">
                {block.headers.map((header) => (
                  <th scope="col" class="px-4 py-3 font-semibold text-fg">
                    <Inline text={header} ctx={ctx} />
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {block.rows.map((row) => (
                <tr class="border-b border-border last:border-b-0">
                  {row.map((cell) => (
                    <td class="px-4 py-3 align-top text-fg-muted">
                      <Inline text={cell} ctx={ctx} />
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {block.type === 'callout' && <Callout tone={block.tone} text={block.text} ctx={ctx} />}

      {block.type === 'logoRow' && (
        <div class="flex flex-wrap gap-3">
          {block.items.map((item) => (
            <div class="flex items-center gap-2 rounded-xl border border-border bg-bg-elevated px-3 py-2">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-primary p-1">
                <img src={item.src} alt={item.alt} width="16" height="16" class="size-4" />
              </span>
              <span class="text-sm font-medium text-fg">{item.label}</span>
            </div>
          ))}
        </div>
      )}

      {block.type === 'faq' && (
        <dl class="space-y-8">
          {block.items.map((item, itemIndex) => (
            <div>
              <dt class="text-lg font-semibold tracking-tight text-fg">
                <Inline text={item.question} ctx={ctx} />
              </dt>
              <dd class="mt-3 space-y-4">
                <DocsBlocks blocks={item.answer} ctx={ctx} idPrefix={`${idPrefix}-faq-${index}-${itemIndex}`} />
              </dd>
            </div>
          ))}
        </dl>
      )}
    </Fragment>
  ))
}
