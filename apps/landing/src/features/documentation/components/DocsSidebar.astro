---
import type { Locale } from '../../i18n/types';
import type { DocContent } from '../content/types';
import DocsNavList from './DocsNavList.astro';

interface Props {
  content: DocContent;
  locale: Locale;
  currentSlug: string;
}

const { content, locale, currentSlug } = Astro.props;
---

{/* Left rail: lg and up. Below lg the same list lives in DocsMobileNav. */}
<div class="docs-rail hidden w-64 shrink-0 p-1 lg:block">
  <nav aria-label={content.navAriaLabel} data-docs-sidebar>
    <DocsNavList content={content} locale={locale} currentSlug={currentSlug} idPrefix="sidebar" />
  </nav>
</div>
