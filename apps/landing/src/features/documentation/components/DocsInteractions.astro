<script>
  import { pickActiveTocId } from '../lib/toc';

  function setCopied(button: HTMLElement, copied: boolean): void {
    const iconCopy = button.querySelector<HTMLElement>('[data-icon-copy]');
    const iconCheck = button.querySelector<HTMLElement>('[data-icon-check]');
    const labelText = button.querySelector<HTMLElement>('[data-copy-label-text]');
    const status = button.querySelector<HTMLElement>('[data-copy-status]');
    const defaultLabel = button.dataset.copyLabel ?? '';
    const copiedLabel = button.dataset.copiedLabel ?? '';

    if (iconCopy) iconCopy.hidden = copied;
    if (iconCheck) iconCheck.hidden = !copied;
    if (labelText) labelText.textContent = copied ? copiedLabel : defaultLabel;
    if (status) status.textContent = copied ? copiedLabel : '';
    button.setAttribute('aria-label', copied ? copiedLabel : defaultLabel);
  }

  function resolveCode(button: HTMLElement): string {
    const group = button.closest<HTMLElement>('[data-code-group]');
    if (group) {
      const activePanel = group.querySelector<HTMLElement>('[data-group-panel]:not([hidden])');
      return activePanel?.dataset.code ?? '';
    }
    const block = button.closest<HTMLElement>('[data-code-block]');
    return block?.dataset.code ?? '';
  }

  async function handleCopy(button: HTMLElement): Promise<void> {
    const code = resolveCode(button);
    if (!code) return;

    try {
      await navigator.clipboard.writeText(code);
    } catch {
      return;
    }

    setCopied(button, true);
    const previousTimeout = Number(button.dataset.copyTimeout ?? '');
    if (!Number.isNaN(previousTimeout)) window.clearTimeout(previousTimeout);
    const timeout = window.setTimeout(() => setCopied(button, false), 2000);
    button.dataset.copyTimeout = String(timeout);
  }

  function activateTab(group: HTMLElement, tab: HTMLElement): void {
    const tabs = Array.from(group.querySelectorAll<HTMLElement>('[data-group-tab]'));
    const panels = Array.from(group.querySelectorAll<HTMLElement>('[data-group-panel]'));

    for (const candidate of tabs) {
      const selected = candidate === tab;
      candidate.setAttribute('aria-selected', String(selected));
      candidate.tabIndex = selected ? 0 : -1;
    }

    const targetId = tab.getAttribute('aria-controls');
    for (const panel of panels) {
      panel.hidden = panel.id !== targetId;
    }
  }

  // Distance from the top of the viewport at which a heading counts as reached:
  // the 4rem fixed header plus a little air, matching the scroll-mt-24 of the
  // headings so that following a link makes its target the active entry.
  const TOC_OFFSET = 96;

  // Both contents lists (the right rail and the collapsible one below xl) carry
  // the same data-toc-link ids, so one pass marks the entry in each of them.
  function initTocSpy(): void {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
    if (links.length === 0) return;

    const ids = new Set(links.map((link) => link.dataset.tocLink ?? '').filter((id) => id !== ''));
    const targets = Array.from(ids)
      .map((id) => document.getElementById(id))
      .filter((target): target is HTMLElement => target !== null)
      .sort((a, b) => (a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1));
    if (targets.length === 0) return;

    let activeId = '';

    function setActive(id: string): void {
      if (id === activeId) return;
      activeId = id;

      for (const link of links) {
        if (link.dataset.tocLink === id) {
          link.setAttribute('data-active', '');
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('data-active');
          link.removeAttribute('aria-current');
        }
      }
    }

    function update(): void {
      const doc = document.documentElement;
      // A page shorter than the viewport is "at the bottom" from the start, which
      // must not light up its last entry before the reader has moved.
      const scrolls = doc.scrollHeight > window.innerHeight + 2;
      const atBottom = scrolls && window.innerHeight + window.scrollY >= doc.scrollHeight - 2;
      const id = pickActiveTocId(
        targets.map((target) => ({ id: target.id, top: target.getBoundingClientRect().top })),
        TOC_OFFSET,
        atBottom,
      );

      if (id !== null) setActive(id);
    }

    let frame = 0;
    function schedule(): void {
      if (frame !== 0) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        update();
      });
    }

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('hashchange', schedule);
    window.addEventListener('load', schedule);

    update();
  }

  initTocSpy();

  function closeDisclosure(details: HTMLDetailsElement): void {
    details.open = false;
  }

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    // A link inside the collapsible menu or contents list closes it before the
    // browser follows the link: closing after the jump would shift the page
    // under the target the reader just chose.
    const disclosureLink = target.closest<HTMLAnchorElement>('[data-docs-disclosure] a');
    if (disclosureLink) {
      const details = disclosureLink.closest<HTMLDetailsElement>('details');
      if (details) closeDisclosure(details);
    }

    const copyButton = target.closest<HTMLElement>('[data-copy-button]');
    if (copyButton) {
      void handleCopy(copyButton);
      return;
    }

    const tab = target.closest<HTMLElement>('[data-group-tab]');
    if (tab) {
      const group = tab.closest<HTMLElement>('[data-code-group]');
      if (group) activateTab(group, tab);
    }
  });

  // Escape closes the open menu or contents list and hands focus back to its summary.
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    const target = event.target;
    if (!(target instanceof Element)) return;

    const details = target.closest<HTMLDetailsElement>('[data-docs-disclosure][open]');
    if (!details) return;

    closeDisclosure(details);
    details.querySelector<HTMLElement>('summary')?.focus();
  });

  document.addEventListener('keydown', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement) || !target.matches('[data-group-tab]')) return;

    const group = target.closest<HTMLElement>('[data-code-group]');
    if (!group) return;

    const tabs = Array.from(group.querySelectorAll<HTMLElement>('[data-group-tab]'));
    const currentIndex = tabs.indexOf(target);
    let nextIndex: number | null = null;

    if (event.key === 'ArrowRight') nextIndex = (currentIndex + 1) % tabs.length;
    else if (event.key === 'ArrowLeft') nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
    else if (event.key === 'Home') nextIndex = 0;
    else if (event.key === 'End') nextIndex = tabs.length - 1;

    if (nextIndex === null) return;

    event.preventDefault();
    const nextTab = tabs[nextIndex];
    nextTab.focus();
    activateTab(group, nextTab);
  });
</script>
