---
import { Copy, Check } from '@phosphor-icons/react';
import { highlight, TOKEN_CLASSES } from '../lib/highlight';
import type { CodeGroupVariant } from '../content/types';

interface Props {
  label: string;
  variants: CodeGroupVariant[];
  /**
   * Prefix of the ids that tie each tab to its panel. It comes from the page
   * (section id plus block position), never from a random value, so two builds
   * of the same content produce the same HTML.
   */
  groupId: string;
  copyLabel: string;
  copiedLabel: string;
}

const { label, variants, groupId, copyLabel, copiedLabel } = Astro.props;
---

<div class="overflow-hidden rounded-xl border border-border bg-bg-subtle" data-code-group>
  {
    /*
      Underlined tab strip. The tabs scroll sideways inside their own strip when
      they do not fit, so a long list never widens the page; the copy button
      stays outside the scroller. The active tab keeps a 2px underline in
      border-primary, the inactive ones stay muted.
    */
  }
  <div class="flex items-stretch justify-between gap-2 border-b border-border bg-bg-elevated pr-2">
    <div
      role="tablist"
      aria-label={label}
      class="flex min-w-0 flex-1 gap-1 overflow-x-auto px-2 scrollbar-thin scrollbar-thumb-border-strong scrollbar-track-transparent"
    >
      {
        variants.map((variant, index) => (
          <button
            type="button"
            role="tab"
            id={`${groupId}-tab-${index}`}
            aria-selected={index === 0}
            aria-controls={`${groupId}-panel-${index}`}
            tabindex={index === 0 ? 0 : -1}
            data-group-tab
            class="shrink-0 whitespace-nowrap border-b-2 border-transparent px-3 py-2.5 text-sm font-medium text-fg-muted transition-colors duration-150 ease-out hover:text-fg aria-selected:border-primary aria-selected:text-fg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-primary motion-reduce:transition-none"
          >
            {variant.label}
          </button>
        ))
      }
    </div>

    {/* Icon only: the strip belongs to the tabs, and the icon turns into a check once copied. */}
    <button
      type="button"
      data-copy-button
      data-copy-label={copyLabel}
      data-copied-label={copiedLabel}
      aria-label={copyLabel}
      title={copyLabel}
      class="my-1.5 inline-flex size-8 shrink-0 items-center justify-center self-center rounded-md border border-border bg-bg text-fg-muted transition-colors duration-150 ease-out hover:bg-bg-hover hover:text-fg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary motion-reduce:transition-none"
    >
      <span data-icon-copy aria-hidden="true"><Copy size={14} /></span>
      <span data-icon-check aria-hidden="true" hidden><Check size={14} weight="bold" /></span>
      <span class="sr-only" data-copy-status aria-live="polite"></span>
    </button>
  </div>

  {
    variants.map((variant, index) => (
      <div
        role="tabpanel"
        id={`${groupId}-panel-${index}`}
        aria-labelledby={`${groupId}-tab-${index}`}
        data-group-panel
        data-code={variant.code}
        hidden={index !== 0}
      >
        {/* One line on purpose: whitespace inside a <pre> is rendered. */}
        <pre class="overflow-x-auto p-4 font-mono text-xs leading-relaxed sm:text-sm"><code>{highlight(variant.code, variant.language).map((token) => <span class={TOKEN_CLASSES[token.kind]}>{token.value}</span>)}</code></pre>
      </div>
    ))
  }
</div>
