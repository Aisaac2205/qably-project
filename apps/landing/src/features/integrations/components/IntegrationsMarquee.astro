---
interface Props {
  locale?: "es" | "en";
}

const { locale = "es" } = Astro.props;
const isEn = locale === "en";

// Only runners and CI tools that the docs actually cover (JUnit XML ingestion).
const tools = [
  { name: "Jest", icon: "/tech-icons/jest-icon.svg" },
  { name: "Playwright", icon: "/tech-icons/playwright.svg" },
  { name: "Python (pytest)", icon: "/tech-icons/python.svg" },
  { name: "Go", icon: "/tech-icons/go.svg" },
  { name: "GitHub Actions", icon: "/logos/githubactions.svg" },
];

const heading = isEn
  ? "Works with any runner or CI that produces JUnit XML"
  : "Compatible con cualquier runner o CI que genere JUnit XML";

const label = isEn ? "Compatible runners and CI tools" : "Runners y herramientas de CI compatibles";
---

<section
  class="py-12 sm:py-16 border-y border-white/[0.08] bg-black overflow-hidden"
  aria-label={label}
>
  <div class="max-w-7xl mx-auto px-6 mb-8 sm:mb-10 text-center">
    <p class="text-sm font-medium text-zinc-400 font-sans">{heading}</p>
  </div>

  <ul class="max-w-7xl mx-auto px-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-6 sm:gap-x-14">
    {
      tools.map((tool) => (
        <li class="flex items-center gap-3 sm:gap-4 group">
          <img
            src={tool.icon}
            alt=""
            aria-hidden="true"
            width="56"
            height="56"
            class="size-10 sm:size-12 object-contain opacity-85 group-hover:opacity-100 transition-opacity duration-200"
            loading="lazy"
          />
          <span class="text-sm sm:text-base font-medium text-zinc-300 group-hover:text-white transition-colors font-sans whitespace-nowrap">
            {tool.name}
          </span>
        </li>
      ))
    }
  </ul>
</section>
