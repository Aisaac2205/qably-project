---
import Landing from "../layouts/Landing.astro";
import Component from "../components/ui/saa-s-template";
import SiteHeader from "../features/navigation/components/SiteHeader.astro";
import IntegrationsMarquee from "../features/integrations/components/IntegrationsMarquee.astro";
import FeaturesGrid from "../features/features-grid/components/FeaturesGrid.astro";
import { DocumentationSection } from "../features/documentation/components/DocumentationSection";
import { PricingSection } from "../features/pricing/components/PricingSection";
import CtaBanner from "../features/navigation/components/CtaBanner.astro";
import Footer from "../features/navigation/components/Footer.astro";
import { getDictionary } from "../features/i18n/get-dictionary";

const locale = "es";
const dict = getDictionary(locale);
---

<Landing locale={locale}>
  <SiteHeader locale={locale} />

  <div id="main-content" class="flex-grow">
    {/* Hero with live Qably Dashboard preview */}
    <Component client:load locale={locale} />

    {/* Integrations Marquee with official tech SVGs */}
    <IntegrationsMarquee locale={locale} />

    <FeaturesGrid locale={locale} />

    {/* Interactive Documentation Section with Tabbed Code Snippets */}
    <DocumentationSection client:visible t={dict.docs} locale={locale} />

    {/* Interactive Pricing Section with Monthly/Annual Toggle */}
    <PricingSection client:visible t={dict.pricing} />

    {/* Bottom Call to Action */}
    <CtaBanner locale={locale} />
  </div>

  {/* Footer */}
  <Footer locale={locale} />
</Landing>
