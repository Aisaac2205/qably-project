---
import Landing from "../../../layouts/Landing.astro";
import Footer from "../../../features/navigation/components/Footer.astro";
import DocsHeader from "../../../features/documentation/components/DocsHeader.astro";
import DocsSidebar from "../../../features/documentation/components/DocsSidebar.astro";
import DocsArticle from "../../../features/documentation/components/DocsArticle.astro";
import { en as content } from "../../../features/documentation/content/en";
import { getAuthUrl } from "../../../lib/auth-config";

const locale = "en";
const authUrl = getAuthUrl('/projects');
---

<Landing locale={locale} title={content.pageTitle} description={content.pageDescription}>
  <DocsHeader locale={locale} authUrl={authUrl} />

  <main id="main-content" class="max-w-7xl mx-auto px-6 py-12 flex-grow grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-12">
    <DocsSidebar content={content} />
    <DocsArticle content={content} />
  </main>

  <Footer locale={locale} />
</Landing>
